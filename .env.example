# Какой мессенджер: max или telegram (если задан MAX_BOT_TOKEN — по умолчанию max)
MESSENGER=max
# Токен бота MAX (платформа MAX для партнёров → Чат-боты → ваш бот). Никому не показывайте
MAX_BOT_TOKEN=
# Токен бота Telegram от @BotFather — только если MESSENGER=telegram
BOT_TOKEN=
# ID администраторов через запятую (узнать: напишите боту /id). Если пусто — админом станет первый, кто нажмёт «Старт»
ADMIN_IDS=
# Куда присылать заявки (если пусто — первому администратору). Можно поменять в админке
MANAGER_CHAT_ID=
PORT=3000
